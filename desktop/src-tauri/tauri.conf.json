{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBO",
  "version": "../../package.json",
  "identifier": "ai.orbo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3020",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "ORBO",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["pkexec", "procps", "lsof", "ca-certificates"] },
      "rpm": {
        "depends": [
          "/usr/bin/pkexec",
          "/usr/bin/ps",
          "/usr/bin/lsof",
          "ca-certificates"
        ]
      }
    },
    "targets": ["dmg", "msi", "nsis", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Opraiz Technology Pvt Ltd",
    "category": "DeveloperTool",
    "shortDescription": "Run ORBO on your own machine",
    "longDescription": "ORBO Desktop installs the container engine, raises the stack, and keeps it running."
  },
  "plugins": {
    "deep-link": {
      "$comment": "Desktop scheme mirrors the unified app scheme in apps/app/app.json; identifier ai.orbo.desktop per PLAN.md 10.B.12.",
      "desktop": { "schemes": ["orbo"] }
    },
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": [],
      "$comment": "TODO (PLAN.md 10.B.14): updater domain undecided - add the release endpoint URL to endpoints once chosen; do not invent a URL. Keep active=false until then."
    }
  }
}
